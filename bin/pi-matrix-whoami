#!/usr/bin/env bash
set -euo pipefail

exec @PI_HARNESS_NODE@ --input-type=module <<'NODE'
const required = [
  "PI_MATRIX_HOMESERVER",
  "PI_MATRIX_ACCESS_TOKEN",
  "PI_MATRIX_BOT_USER_ID",
];

for (const name of required) {
  if (!process.env[name]) {
    console.error(`pi-matrix-whoami: ${name} is required`);
    process.exit(2);
  }
}

const homeserver = process.env.PI_MATRIX_HOMESERVER;
const accessToken = process.env.PI_MATRIX_ACCESS_TOKEN;
const expectedUserId = process.env.PI_MATRIX_BOT_USER_ID;
const controller = new AbortController();
const timeout = setTimeout(() => controller.abort(), 15_000);

try {
  const endpoint = new URL("/_matrix/client/v3/account/whoami", homeserver);
  const response = await fetch(endpoint, {
    headers: { Authorization: `Bearer ${accessToken}` },
    signal: controller.signal,
  });

  if (!response.ok) {
    console.error(`pi-matrix-whoami: Matrix returned HTTP ${response.status}`);
    process.exit(1);
  }

  const payload = await response.json();
  if (payload.user_id !== expectedUserId) {
    console.error(
      `pi-matrix-whoami: expected ${expectedUserId}, authenticated as ${String(payload.user_id)}`,
    );
    process.exit(1);
  }

  process.stdout.write(`${payload.user_id}\n`);
} catch (error) {
  const message = error instanceof Error ? error.message : "request failed";
  console.error(`pi-matrix-whoami: ${message}`);
  process.exit(1);
} finally {
  clearTimeout(timeout);
}
NODE
