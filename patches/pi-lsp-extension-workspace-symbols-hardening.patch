+function supportsWorkspaceSymbols(status: { capabilities?: { workspaceSymbols: boolean | null } }): boolean {
+  return status.capabilities?.workspaceSymbols !== false;
+}
+
+async function withWorkspaceSymbolTimeout<T>(request: Promise<T>): Promise<T> {
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  const timeout = new Promise<never>((_, reject) => {
+    timer = setTimeout(() => reject(new Error(`workspace/symbol timed out after ${WORKSPACE_SYMBOL_TIMEOUT_MS}ms`)), WORKSPACE_SYMBOL_TIMEOUT_MS);
+  });
+  try {
+    return await Promise.race([request, timeout]);
+  } finally {
+    if (timer) clearTimeout(timer);
+  }
+}
