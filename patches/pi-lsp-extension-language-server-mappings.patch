 };
+
+/** Map extensionless filenames to LSP language IDs */
+export const NAME_TO_LANGUAGE: Record<string, string> = {
+  "dockerfile": "dockerfile",
+  "containerfile": "dockerfile",
+};
 
 /** Get the language ID for a file path based on extension */
 export function getLanguageIdFromPath(filePath: string): string | undefined {
+  const fileName = filePath.split(/[\\/]/).pop()?.toLowerCase();
+  if (fileName && NAME_TO_LANGUAGE[fileName]) return NAME_TO_LANGUAGE[fileName];
+
   const ext = filePath.match(/\.[^.]+$/)?.[0]?.toLowerCase();
   return ext ? EXT_TO_LANGUAGE[ext] : undefined;
 }
