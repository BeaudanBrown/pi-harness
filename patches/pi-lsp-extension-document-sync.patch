+  /**
+   * Ensure a target file has been opened on the active LSP client before
+   * file-scoped textDocument requests. This covers files read before a server
+   * existed and documents whose previous client crashed or restarted.
+   */
+  async ensureFileOpen(filePath: string, client?: unknown): Promise<void> {
+    const absPath = this.manager.resolvePath(filePath);
+    const uri = this.manager.getFileUri(absPath);
+    const languageId = this.manager.getLanguageId(absPath);
+    if (!languageId) return;
+
+    const lspClient = (client ?? this.manager.getRunningClient(languageId)) as {
+      didOpen(uri: string, languageId: string, version: number, text: string): void;
+    } | null;
+    if (!lspClient) return;
+
+    const existing = this.tracked.get(uri);
+    if (existing?.syncedClient === lspClient) {
+      this.touchAndEvict(uri);
+      return;
+    }
+
+    try {
+      const content = await readFile(absPath, "utf-8");
+      const version = existing ? existing.version + 1 : 1;
+      const doc: TrackedDocument = { uri, languageId, version, syncedClient: lspClient };
+      this.tracked.set(uri, doc);
+      lspClient.didOpen(uri, languageId, version, content);
+      this.touchAndEvict(uri);
+    } catch {
+      // File might not exist or be unreadable — ignore.
+    }
+  }
