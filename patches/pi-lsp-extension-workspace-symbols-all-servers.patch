+function workspaceSymbolKey(sym: SymbolInformation | WorkspaceSymbol, rootDir: string): string {
+  let location = "";
+  if ("location" in sym && sym.location) {
+    try {
+      const absPath = fileURLToPath(sym.location.uri);
+      const loc = sym.location as any;
+      const line = loc.range ? loc.range.start.line + 1 : "?";
+      const char = loc.range ? loc.range.start.character + 1 : "?";
+      location = `${relative(rootDir, absPath)}:${line}:${char}`;
+    } catch {
+      location = sym.location.uri;
+    }
+  }
+
+  return `${sym.name}\u0000${sym.kind}\u0000${location}`;
+}
