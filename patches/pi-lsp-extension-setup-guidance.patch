+function setupGuidanceForDiagnostic(diag: Diagnostic): string | null {
+  const message = diag.message.toLowerCase();
+  const source = String(diag.source ?? "").toLowerCase();
+  const code = diag.code !== undefined ? String(diag.code).toLowerCase() : "";
+  const looksLikeTypeScript = source.includes("ts") || source.includes("typescript") || /^ts\d+$/i.test(code);
+
+  if (message.includes("no project") || message.includes("project context")) {
+    return "TypeScript did not find a project for this file; launch Pi from the project dev shell/root or add a project-owned tsconfig.json/jsconfig.json.";
+  }
+
+  if (!looksLikeTypeScript) return null;
+
+  if (message.includes("cannot find type definition file for 'node'") || message.includes('cannot find type definition file for "node"') || message.includes("cannot find name 'process'") || message.includes('cannot find name "process"') || message.includes("cannot find name 'require'") || message.includes('cannot find name "require"')) {
+    return "Node types are missing from the project environment/config; add project-owned @types/node/tsconfig types or enter the project's dev shell.";
+  }
+
+  if (message.includes("cannot find module") || message.includes("could not find a declaration file for module") || message.includes("cannot find namespace")) {
+    return "TypeScript cannot resolve a project dependency or declaration; run Pi from the project dev shell/direnv and ensure package deps/types are installed by the project.";
+  }
+
+  return null;
+}
+
+function appendSetupGuidance(text: string, diagnostics: Diagnostic[]): string {
+  const guidance = [...new Set(diagnostics.map(setupGuidanceForDiagnostic).filter((v): v is string => Boolean(v)))];
+  if (guidance.length === 0) return text;
+  return `${text}\n\nSetup guidance:\n${guidance.map((line) => `- ${line}`).join("\n")}`;
+}
