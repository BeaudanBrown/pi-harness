+
+function getSetupHint(languageId: string, message: string): string | undefined {
+  const lower = message.toLowerCase();
+  const isTypeScript = ["typescript", "javascript", "typescriptreact", "javascriptreact"].includes(languageId);
+
+  if (lower.includes("enoent") || lower.includes("not found") || lower.includes("failed to spawn")) {
+    return "Ensure the language server command is available in PATH by launching Pi from the project dev shell/direnv, or configure a project-owned .pi-lsp.json server command.";
+  }
+
+  if (isTypeScript && (lower.includes("no project") || lower.includes("tsconfig") || lower.includes("jsconfig"))) {
+    return "TypeScript needs a project context; launch Pi from the project root/dev shell or add a project-owned tsconfig.json/jsconfig.json.";
+  }
+
+  if (isTypeScript && (lower.includes("cannot find module") || lower.includes("cannot find type definition") || lower.includes("module resolution"))) {
+    return "TypeScript dependency resolution is owned by this repo; enter the project dev shell/direnv and install or configure project deps/types rather than relying on the harness fallback server.";
+  }
+
+  return undefined;
+}
