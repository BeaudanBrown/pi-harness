{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-harness.invalid/eval/launcher/v1/runtime-provenance.schema.json",
  "title": "Verified evaluation runtime provenance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "verifiedBeforePrompt", "runtimeAttestationVerified", "launcher", "pi", "harness", "piR", "project", "activeModel", "rpcCommands", "concurrency", "environment"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "status": { "enum": ["verified", "failed"] },
    "verifiedBeforePrompt": { "const": true },
    "runtimeAttestationVerified": { "type": "boolean" },
    "launcher": {
      "type": "object", "additionalProperties": false, "required": ["id", "path", "args"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/absolutePath" },
        "args": { "type": "array", "items": { "type": "string" } }
      }
    },
    "pi": { "$ref": "#/$defs/versionIdentity" },
    "harness": { "$ref": "#/$defs/revisionIdentity" },
    "piR": {
      "type": "object", "additionalProperties": false, "required": ["revision", "resourceRoot", "extensionPath", "skillPath"],
      "properties": {
        "revision": { "type": "string", "minLength": 1 },
        "resourceRoot": { "$ref": "#/$defs/absolutePath" },
        "extensionPath": { "$ref": "#/$defs/absolutePath" },
        "skillPath": { "$ref": "#/$defs/absolutePath" }
      }
    },
    "project": {
      "type": "object", "additionalProperties": false, "required": ["root", "revision", "dirty"],
      "properties": {
        "root": { "$ref": "#/$defs/absolutePath" },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
        "dirty": { "type": "boolean" }
      }
    },
    "activeModel": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false, "required": ["provider", "id"],
          "properties": { "provider": { "type": "string", "minLength": 1 }, "id": { "type": "string", "minLength": 1 } }
        }
      ]
    },
    "rpcCommands": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "concurrency": { "type": "integer", "minimum": 1 },
    "environment": {
      "type": "object", "additionalProperties": false, "required": ["inherited", "overrideKeys", "sensitiveValuesPersisted"],
      "properties": {
        "inherited": { "const": true },
        "overrideKeys": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "sensitiveValuesPersisted": { "const": false }
      }
    },
    "failure": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "absolutePath": { "type": "string", "pattern": "^/", "minLength": 2 },
    "versionIdentity": { "type": "object", "additionalProperties": false, "required": ["version"], "properties": { "version": { "type": "string", "minLength": 1 } } },
    "revisionIdentity": { "type": "object", "additionalProperties": false, "required": ["revision"], "properties": { "revision": { "type": "string", "minLength": 1 } } }
  }
}
