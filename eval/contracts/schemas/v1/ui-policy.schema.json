{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ui-policy.schema.json",
  "title": "Extension UI response policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["defaultAction", "dialogs"],
  "properties": {
    "defaultAction": { "const": "deny" },
    "dialogs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["extensionId", "requestType", "title", "response"],
        "properties": {
          "extensionId": { "$ref": "common.schema.json#/$defs/stableId" },
          "requestType": { "enum": ["confirm", "select", "input", "editor"] },
          "title": { "type": "string", "minLength": 1, "maxLength": 500 },
          "response": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["action"],
                "properties": { "action": { "const": "deny" } }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["action", "value"],
                "properties": {
                  "action": { "const": "approve" },
                  "value": { "type": ["string", "boolean"] }
                }
              }
            ]
          }
        }
      }
    }
  }
}
