{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scenario.schema.json",
  "title": "Synthetic evaluation scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "synthetic",
    "variant",
    "fabricatedQuestion",
    "materialization",
    "provenance",
    "prompts",
    "timeouts",
    "uiPolicy",
    "assertions"
  ],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "id": { "$ref": "common.schema.json#/$defs/stableId" },
    "version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "synthetic": { "const": true },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "seed"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/stableId" },
        "seed": { "type": ["integer", "string"] }
      }
    },
    "fabricatedQuestion": { "type": "string", "minLength": 1, "maxLength": 10000 },
    "materialization": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["fixture"],
          "properties": {
            "fixture": {
              "type": "object",
              "additionalProperties": false,
              "required": ["workspacePath", "oraclePath"],
              "properties": {
                "workspacePath": { "$ref": "common.schema.json#/$defs/relativePackPath" },
                "oraclePath": { "$ref": "common.schema.json#/$defs/relativePackPath" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["generator"],
          "properties": {
            "generator": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "args", "outputs"],
              "properties": {
                "path": { "$ref": "common.schema.json#/$defs/relativePackPath" },
                "args": { "type": "array", "items": { "type": "string" } },
                "outputs": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["workspacePath", "questionPath", "oraclePath", "provenancePath"],
                  "properties": {
                    "workspacePath": { "$ref": "common.schema.json#/$defs/relativePackPath" },
                    "questionPath": { "$ref": "common.schema.json#/$defs/relativePackPath" },
                    "oraclePath": { "$ref": "common.schema.json#/$defs/relativePackPath" },
                    "provenancePath": { "$ref": "common.schema.json#/$defs/relativePackPath" }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "provenance": { "$ref": "synthetic-provenance.schema.json" },
    "prompts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "prompt.schema.json" }
    },
    "timeouts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["promptMs", "runMs"],
      "properties": {
        "promptMs": { "$ref": "common.schema.json#/$defs/positiveMilliseconds" },
        "runMs": { "$ref": "common.schema.json#/$defs/positiveMilliseconds" }
      }
    },
    "uiPolicy": { "$ref": "ui-policy.schema.json" },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "assertion.schema.json" }
    }
  }
}
