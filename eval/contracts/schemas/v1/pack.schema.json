{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pack.schema.json",
  "title": "Synthetic evaluation pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "syntheticOnly", "scenarios", "suites"],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "id": { "$ref": "common.schema.json#/$defs/stableId" },
    "version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "syntheticOnly": { "const": true },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/relativePackPath" }
    },
    "suites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "scenarios"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/stableId" },
          "scenarios": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "common.schema.json#/$defs/stableId" }
          }
        }
      }
    },
    "baselineSummaries": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/relativePackPath" }
    }
  }
}
